NGALIHIYA_PDF_PORT=8080
NGALIHIYA_PUBLIC_URL=https://ngalihyapdf.com

# Enable account login after creating Google OAuth credentials.
NGALIHIYA_ENABLE_LOGIN=true
NGALIHIYA_LOGIN_METHOD=oauth2

# Google OAuth credentials from Google Cloud Console.
NGALIHIYA_GOOGLE_LOGIN_ENABLED=true
NGALIHIYA_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
NGALIHIYA_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Allow new Google users to create accounts automatically.
NGALIHIYA_GOOGLE_AUTO_CREATE_USERS=true
NGALIHIYA_GOOGLE_BLOCK_REGISTRATION=false

# Keep a strong admin password for emergency/admin setup if normal login is enabled later.
NGALIHIYA_ADMIN_USER=admin
NGALIHIYA_ADMIN_PASSWORD=replace-with-a-long-random-password

NGALIHIYA_MAX_FILE_SIZE_MB=100
